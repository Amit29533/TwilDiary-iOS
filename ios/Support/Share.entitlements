<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Saved clips: the share sheet writes them where the app reads them. A sideloading tool
	     keeps (or renames) the group when it supports app groups. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.amit29533.TwilDiary</string>
	</array>
</dict>
</plist>
