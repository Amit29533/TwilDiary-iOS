{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "twildiary-trakt-incoming",
  "account_id": "2e8626da5c1177fdfc53aadaef4ec1f7",
  "main": "index.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  // Phase 4c: the app writes to Trakt itself, so the every-minute import is off. To turn it
  // back on, restore ["* * * * *"] and deploy this worker again.
  "triggers": { "crons": [] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "twildiary-v2",
    "database_id": "fee4edca-0618-44fb-b110-0a9ecb3dfe17",
    "migrations_dir": "../../drizzle"
  }],
  "observability": { "enabled": true }
}
